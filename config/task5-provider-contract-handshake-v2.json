{
  "schema_version": "task5-provider-contract-handshake.v2",
  "purpose": "Design-exit and pre-M302 feasibility handshake for the provider-required Task5 seams; all handshake calls are fake/local and never authorize a real provider run.",
  "source_identity": {
    "schema": "selected-source-identity.v1",
    "canonical_row_fields": [
      "source_id",
      "canonical_relative_path",
      "snapshot_id",
      "raw_content_hash",
      "byte_count",
      "line_count",
      "block_refs"
    ],
    "block_ref_fields": [
      "block_id",
      "block_content_hash",
      "raw_start_byte",
      "raw_end_byte",
      "locator"
    ],
    "canonical_json": "utf8_recursive_key_sort_no_spaces_no_nan_trailing_lf",
    "source_sort": ["canonical_relative_path", "source_id"],
    "block_sort": ["raw_start_byte", "raw_end_byte", "block_id"]
  },
  "llm_handshake": {
    "route_kinds": [
      "quality-reader",
      "source-direct-audit"
    ],
    "request_identity_fields": [
      "evaluation_mode",
      "route_kind",
      "source_id_or_projection_key",
      "source_hash",
      "selected_source_paths_sha256",
      "selected_source_closure_sha256",
      "input_snapshot_sha256",
      "prompt_sha256",
      "provider_identity"
    ],
    "success_receipt_fields": [
      "request_identity",
      "source_hash",
      "selected_source_closure_sha256",
      "schema_ref",
      "schema_sha256",
      "response_sha256",
      "normalized_output_sha256",
      "semantic_status",
      "lineage_check",
      "raw_copy_check",
      "failure_reason"
    ],
    "required_fake_cases": [
      "quality_reader_compiled_output",
      "source_direct_claim_fragment_output",
      "malformed_json_rejected",
      "route_branch_mismatch_rejected",
      "multi_source_closure_reorder_changes_identity",
      "multi_source_block_hash_drift_changes_identity"
    ],
    "must_not_call_network": true
  },
  "embedding_handshake": {
    "request_identity_fields": [
      "evaluation_mode",
      "projection_key",
      "query_sha256",
      "candidate_set_sha256",
      "descriptor_sha256",
      "selected_source_paths_sha256",
      "selected_source_closure_sha256",
      "provider_identity",
      "calibration_sha256",
      "calibration_manifest_ref",
      "calibration_manifest_sha256"
    ],
    "success_receipt_fields": [
      "request_identity",
      "source_hash",
      "selected_source_closure_sha256",
      "vector_dimension",
      "query_vector_sha256",
      "candidate_vector_sha256s",
      "top_k",
      "selected_source_paths",
      "route_only_source_paths",
      "selected_paths_consumed_by_qwen",
      "calibration_manifest_ref",
      "calibration_manifest_sha256"
    ],
    "required_fake_cases": [
      "full_candidate_route",
      "slice_candidate_route",
      "extra_selected_path_rejected",
      "selected_vector_not_consumed_rejected",
      "multi_source_closure_reorder_changes_identity",
      "multi_source_block_hash_drift_changes_identity"
    ],
    "must_not_call_network": true
  },
  "gate_requirements": {
    "R1": "produce_and_hash_llm_handshake_receipt_before_any_real_provider_call",
    "R3": "produce_and_hash_embedding_handshake_receipt_before_any_real_provider_call",
    "M302": "reject_if_either_handshake_missing_or_contract_hash_mismatched",
    "M401_R": "review_handshake_receipts_and_their_test_oracles",
    "M402": "must_not_use_handshake_as_real_provider_result"
  },
  "canonical_bytes": {
    "encoding": "utf-8",
    "sort_keys": true,
    "separators": [
      ",",
      ":"
    ],
    "ensure_ascii": false,
    "trailing_newline": true
  }
}
