{
  "schema_version": "task5-replay-store.v1",
  "store_id": "task5-semantic-response-replay-v1",
  "owner": "KnowledgeDigest Task5 runtime only",
  "path": "~/.config/knowledge-digest/replay/task5-semantic-response-ledger.jsonl",
  "directory_mode": "0700",
  "file_mode": "0600",
  "write_policy": "append_only_create_only; one authenticated writer; conflict becomes response_variant",
  "canonical_bytes": "UTF-8 JSON, recursively sort object keys by Unicode code point, arrays keep order, separators=(',', ':'), ensure_ascii=false, trailing LF",
  "replay_eligibility": {
    "provider_mode": "real",
    "provider_status": "success",
    "provider_calls": 1,
    "http_attempts": 1,
    "source_sensitive_scan": "passed",
    "selected_source_closure_sha256": "required_for_single_and_multi_source",
    "identity_match": "exact_all_fields"
  },
  "required_entry_fields": [
    "schema_version",
    "request_identity",
    "original_run_identity",
    "provider_identity",
    "provider_mode",
    "provider_receipt_ref",
    "provider_receipt_sha256",
    "provider_call_ledger_ref",
    "provider_call_ledger_sha256",
    "http_attempts",
    "source_snapshot_id",
    "source_hash",
    "selected_source_closure_sha256",
    "selected_source_paths",
    "config_hash",
    "runtime_contract_id",
    "runtime_contract_hash",
    "semantic_contract_id",
    "semantic_contract_hash",
    "prompt_contract_sha256",
    "compiler_snapshot",
    "parser_snapshot",
    "response_hash",
    "normalized_response_hash",
    "normalized_typed_json"
  ],
  "original_run_identity": ["task_id", "run_id", "source_snapshot_id", "input_manifest_sha256", "created_at"],
  "compiler_snapshot": ["implementation_snapshot_ref", "implementation_snapshot_sha256", "compiler_version"],
  "parser_snapshot": ["semantic_frame_contract_sha256", "raw_coordinate_contract_sha256", "normalizer_version"],
  "forbidden_entry_fields": ["api_key", "authorization", "prompt", "raw_response", "raw_source", "absolute_local_path"],
  "lookup": "request_identity plus every required identity/hash field must match; missing, drift, permission error or variant blocks replay",
  "consumer_rule": "a replay hit may set provider_calls=0 only after the stored real receipt and all identities are revalidated against the current run"
}
